# ---------------------------------------------------------------------------
# Plantilla de variables de entorno - copiar a `.env` y ajustar valores
#   cp .env.example .env
# ---------------------------------------------------------------------------
# Reglas:
#   1. Solo las variables con prefijo EXPO_PUBLIC_ llegan al codigo del cliente.
#   2. Todo lo que este aqui queda embebido en el bundle -> sin secretos.
#   3. Tras editar el .env hay que reiniciar con `npx expo start --clear`.
#   4. El contrato tipado de estas variables vive en src/config/env.ts
# ---------------------------------------------------------------------------

# URL base del API COMRED, incluyendo el prefijo de version (PREFIX=v1)
#   - Web / iOS simulator ....... http://localhost:3000/v1
#   - Emulador Android .......... http://10.0.2.2:3000/v1
#   - Dispositivo fisico ........ http://<IP-LAN-de-tu-PC>:3000/v1
#   - Produccion ................ https://api.tu-dominio.com/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/v1

# Entorno logico de la app: development | staging | production
EXPO_PUBLIC_ENV=development

# Timeout en milisegundos para las peticiones HTTP
EXPO_PUBLIC_API_TIMEOUT=20000
